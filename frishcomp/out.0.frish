}⎩38⎭
⎩39⎭
defsubr xcr { %eol }⎩40⎭
defsubr xdot { ⌈ ( n --) Print TOS ⌉ %print (%pop) %eol }⎩41⎭
defsubr xdots { ⌈ ( --) Print stack contents ⌉ %print (%stack) %eol }⎩42⎭
⎩43⎭
defsubr xadd {⎩44⎭
    ⌈ ( a b -- sum) ⌉⎩45⎭
    deftemp B ⇐ %pop⎩46⎭
    deftemp A ⇐ %pop⎩47⎭
    %push (A + B)⎩48⎭
}⎩49⎭
⎩50⎭
defsubr xmul {⎩51⎭
    ⌈ ( a b -- product ) ⌉⎩52⎭
