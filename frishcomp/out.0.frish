}⎩139⎭
⎩140⎭
defsubr xswap {⎩141⎭
    ⌈ ( a b -- b a) ⌉⎩142⎭
    deftemp B ⇐ %pop⎩143⎭
    deftemp A ⇐ %pop⎩144⎭
    %push (B)⎩145⎭
    %push (A)⎩146⎭
}⎩147⎭
defsubr xsub {⎩148⎭
    ⌈ ( a b -- diff) ⌉⎩149⎭
    deftemp B ⇐ %pop⎩150⎭
    deftemp A ⇐ %pop⎩151⎭
    %push (A - B)⎩152⎭
}⎩153⎭
defsubr xdiv {⎩154⎭
    ⌈ ( a b -- div) ⌉⎩155⎭
    @xswap⎩156⎭
    deftemp B ⇐ %pop⎩157⎭
    deftemp A ⇐ %pop⎩158⎭
    %funcall State.S.append (B / A)⎩159⎭
}⎩160⎭
⎩161⎭
defsubr xword {⎩162⎭
    ⌈ (char -- string) Read in string delimited by char ⌉⎩163⎭
    deftemp wanted ⇐ %popchar⎩164⎭
    %scanfor (wanted)⎩165⎭
}⎩166⎭
⎩167⎭
⌈ Example of state-smart word, which Brodie sez not to do. Sorry, Leo... ⌉⎩168⎭
⌈ This sin allows it to be used the same way compiling or interactive. ⌉⎩169⎭
defsubr xquote {⎩170⎭
    ⌈ ( -- string) Read up to closing dquote, push to stack ⌉⎩171⎭
    ⌈ A string in Forth begins with the word " (followed by a space) then all characters up to the next " ⌉⎩172⎭
    ⌈ E.G. " abc" ⌉⎩173⎭
    defsynonym DQ ≡ 34⎩174⎭
    %push (DQ)⎩175⎭
    @xword⎩176⎭
    if %inCompilationState {⎩177⎭
        %funcall literalize ()⎩178⎭
    }⎩179⎭
}⎩180⎭
⎩181⎭
defsubr xdotquote {⎩182⎭
    ⌈ ( -- ) parse and print a string ⌉⎩183⎭
    ⌈ ." Hello, World!" ⌉⎩184⎭
    @xquote⎩185⎭
    deftemp s ⇐ %pop⎩186⎭
    %print (s)⎩187⎭
}⎩188⎭
⎩189⎭
defsubr xcomment {⎩190⎭
    ⌈ ( -- ) parse and discard a comment ⌉⎩191⎭
    ⌈ e.g. ( a b c ) ⌉⎩192⎭
    defsynonym RPAR ≡ 42⎩193⎭
    %push(RPAR)⎩194⎭
    @xword⎩195⎭
    %pop⎩196⎭
}⎩197⎭
⎩198⎭
⎩199⎭
defsubr xdoliteral {⎩200⎭
    ⌈⎩201⎭
 Inside definitions only, pushes compiled literal to stack ⎩202⎭
    ⎩203⎭
     Certain Forth words are only applicable inside compiled sequences of subroutines ⎩204⎭
     Literals are handled in different ways when interpreted when in the REPL vs⎩205⎭
     compiled into sequences of subrs ⎩206⎭
     In the REPL, when we encounter a literal, we simply push it onto the stack ⎩207⎭
     In the compiler, though, we have to create an instruction that pushes ⎩208⎭
       the literal onto the stack. ⎩209⎭
       Compiled code doesn't do what the REPL does, we have to hard-wire and ⎩210⎭
       bake in code that pushes the literal when the time comes to run the sequence. ⎩211⎭
⎩212⎭
     This word - "(literal)" - is a simple case and one could actually type this ⎩213⎭
       instruction into the REPL, but, that would be redundant.  Other kinds of words, ⎩214⎭
       e.g. some control-flow words, tend to be messier and the code below only handles ⎩215⎭
       the compiled aspects and ignores the REPL aspects ⎩216⎭
⎩217⎭
     "IP" is the current word index in a sequence of words being compiled. ⎩218⎭
⌉⎩219⎭
    defsynonym lit ≡ RAM [IP]⎩220⎭
    %push (lit)⎩221⎭
    %incIP ⌈ move past this item (the literal) - we're done with it ⌉⎩222⎭
}⎩223⎭
⎩224⎭
defsubr literalize {⎩225⎭
    deftemps found, address ⇐ %lookup ("(literal)")⎩226⎭
    %ignore (found)⎩227⎭
    %funcall RAM.append (address)⎩228⎭
    %funcall RAM.append (%pop)⎩229⎭
}⎩230⎭
⎩231⎭
defsubr xbranch {⎩232⎭
    ⌈ This instruction appears only inside subroutine sequences, jump to address in next cell ⌉⎩233⎭
    ⌈ This instruction is inserted into a subr sequence when compiling control-flow words, like "else" see below) ⌉⎩234⎭
    IP ⇐ RAM [IP]⎩235⎭
    ⌈ normally, we just execute an instruction then move the IP sequentially forward by 1 unit, i.e. IP ⇐ IP + 1 ⌉⎩236⎭
    ⌈   in this case, though, we explicitly change the IP to some other value and don't just increment it ⌉⎩237⎭
}⎩238⎭
⎩239⎭
defsubr x0branch {⎩240⎭
    ⌈ This instruction appears only inside subroutine sequences, jump on false to address in next cell ⌉⎩241⎭
    deftemp test ⇐ %toboolean (%pop)⎩242⎭
    if (test) {⎩243⎭
        %incIP⎩244⎭
    } else {⎩245⎭
        IP ⇐ RAM [IP]⎩246⎭
    }⎩247⎭
}⎩248⎭
⎩249⎭
⎩250⎭
⌈ "immediate" words are fully operational even when in compile mode. Some (not all) of these words are meant to⎩251⎭
    work /only/ in compile mode. At the REPL prompt ("interpret" mode), they produce unwanted results.⎩252⎭
  immediate words: xif, xelse, xthen, xquote, xcomment, xsemi⎩253⎭
  immediate words that only have meaning in compile mode: xif, xelse, xthen, xsemi⎩254⎭
⌉⎩255⎭
⎩256⎭
⎩257⎭
⌈ IF, ELSE and THEN are "immediate" words - they should only be used inside of ":" (colon compiler) ⌉⎩258⎭
⎩259⎭
⌈ see diagram `compiling-IF-THEN.drawio.png` ⌉⎩260⎭
defsubr xif {⎩261⎭
    %immediate ⌈ This instruction appears only inside subroutine sequences, ( f -- ) compile if test and branchFalse ⌉⎩262⎭
    ⌈ Step. 1: generate conditional branch to yet-unknown target1 ⌉⎩263⎭
    deftemps found, branchFalseAddress ⇐ %lookup ("0branch")⎩264⎭
    %ignore (found)⎩265⎭
    %funcall RAM.append (branchFalseAddress) ⌈ insert branch-if-false opcode (word) ⌉⎩266⎭
    %rpush (%RAMnext) ⌈ target1 onto r-stack as memo for later fixup ⌉⎩267⎭
    defsynonym target1 ≡ -1⎩268⎭
    %funcall RAM.append (target1) ⌈ branch target will be fixed up later ⌉⎩269⎭
    ⌈ Step. 2: generate code for true branch - return to compiler which will compile the following words ⌉⎩270⎭
    ⌈ THEN or ELSE will do the fixup of target1 ⌉⎩271⎭
}⎩272⎭
⎩273⎭
⌈ see diagram `compiling-IF-ELSE-THEN.drawio.png` ⌉⎩274⎭
defsubr xelse {⎩275⎭
    %immediate⎩276⎭
    ⌈ Step. 1: fixup target1 from IF-true, retrieving memo from R-stack ⌉⎩277⎭
    deftemp target1 ⇐ %rpop⎩278⎭
    RAM [target1] ⇐ %RAMnext⎩279⎭
    ⌈ Step. 2: generate unconditional branch for preceding IF, creating new memo for target2 on R-stack ⌉⎩280⎭
    deftemps found, brAddress ⇐ %lookup ("branch")⎩281⎭
    %rpush (%RAMnext) ⌈ target2 address on R-stack as memo for later fixup ⌉⎩282⎭
    defsynonym target2 ≡ -1⎩283⎭
    %funcall RAM.append (target2) ⌈ branch target will be fixed up later ⌉⎩284⎭
    ⌈ Step. 3: generate code for false branch - return to compiler which will compile the following words ⌉⎩285⎭
    ⌈ THEN will do the fixup of target2 ⌉⎩286⎭
}⎩287⎭
⎩288⎭
⌈ see diagrams `compiling-IF-THEN.drawio.png` and `compiling-IF-ELSE-THEN.drawio.png` ⌉⎩289⎭
defsubr xthen {⎩290⎭
    %immediate⎩291⎭
    ⌈ Step. 1: fixup target (from IF or from ELSE, above), retrieving memo from R-stack ⌉⎩292⎭
    deftemp target ⇐ %rpop⎩293⎭
    RAM [target] ⇐ %RAMnext⎩294⎭
}⎩295⎭
⎩296⎭
⎩297⎭
⌈  "... 123 constant K ..." ⌉⎩298⎭
⌈  at interpretation time: 123 is on the Stack, we have consumed "constant" from BUFF, BUFF now contains "K ..." ⌉⎩299⎭
⌈  invoke 'word' which parses "K" and pushed it. The stack becomes [... 123 "K"] ⌉⎩300⎭
⌈  pop "K", pop 123, create a new word called 'K' with its PFA set to 123 and its CFA set to a subr that⎩301⎭
     gets 123 from its PFA and pushes it onto the stack ⌉⎩302⎭
defsubr xconst {⎩303⎭
    ⌈  get next word - the name - from BUFF ⌉⎩304⎭
    defsynonym blank ≡ 32⎩305⎭
    %push (blank)⎩306⎭
    @word⎩307⎭
    ⌈  stack is now: ( NNNN name -- ) ⌉⎩308⎭
    deftemp name ⇐ %pop⎩309⎭
    deftemp value ⇐ %pop⎩310⎭
    defsynonym normal ≡ 0⎩311⎭
    deftemp fobj ⇐ %funcall code (name, normal, ↪︎doconst)⎩312⎭
    %fobjappend (fobj, value)⎩313⎭
}⎩314⎭
defsubr doconst {  ⌈ method for const ⌉⎩315⎭
    defsynonym parameter ≡ RAM [W + 1]⎩316⎭
    %push (parameter)⎩317⎭
}⎩318⎭
⎩319⎭
⎩320⎭
defsubr docreate {⎩321⎭
    defsynonym parameterAddress ≡ %funcall len (RAM) + 4⎩322⎭
    %push (parameterAddress)⎩323⎭
}⎩324⎭
deffunction create (name) {⎩325⎭
    defsynonym normal ≡ 0⎩326⎭
    %funcall code (name, normal, ↪︎docreate)⎩327⎭
}⎩328⎭
defsubr xcreate {⎩329⎭
    defsynonym blank ≡ 32⎩330⎭
    %push (blank)⎩331⎭
    @word⎩332⎭
    deftemp name ⇐ %pop⎩333⎭
    %funcall create (name)⎩334⎭
}⎩335⎭
⎩336⎭
deffunction comma (value) {⎩337⎭
    %funcall RAM.append (value)⎩338⎭
}⎩339⎭
⎩340⎭
defsubr xcomma {⎩341⎭
    %funcall comma (%pop)⎩342⎭
}⎩343⎭
⎩344⎭
deffunction fvar (name, value) {⎩345⎭
    %funcall create (name)⎩346⎭
    %funcall comma (value)⎩347⎭
}⎩348⎭
⎩349⎭
defsubr xvar {⎩350⎭
    defsynonym blank ≡ 32⎩351⎭
    %push (blank)⎩352⎭
    @word⎩353⎭
    deftemp name ⇐ %pop⎩354⎭
    deftemp value ⇐ %pop⎩355⎭
    %funcall fvar (name, value)    ⎩356⎭
}⎩357⎭
⎩358⎭
defsubr xdump {⎩359⎭
    deftemp n ⇐ %toint (%pop)⎩360⎭
    deftemp start ⇐ %toint (%pop)⎩361⎭
    %print ("----------------------------------------------------------------")⎩362⎭
    deftemp a ⇐ start⎩363⎭
    while (a < start + %funcall (min (n, (%funcall len (RAM) - start)))) {⎩364⎭
        %print (a)⎩365⎭
	%print (": ")⎩366⎭
	%print (RAM [a])⎩367⎭
	%eol⎩368⎭
        deftemp a ⇐ a + 1⎩369⎭
    }⎩370⎭
}⎩371⎭
⎩372⎭
defsubr xstore {⎩373⎭
    deftemp b ⇐ %pop⎩374⎭
    deftemp a ⇐ %pop⎩375⎭
    RAM [b] ⇐ a⎩376⎭
}⎩377⎭
⎩378⎭
defsubr xbye { ⌈ ( --) Leave interpreter ⌉ %quit }⎩379⎭
⎩380⎭
⎩381⎭
deffunction _find(name) {⎩382⎭
    ⌈ "( name -- cfa|0) Find CFA of word name." ⌉⎩383⎭
    deftemp x ⇐ LAST⎩384⎭
    while (x >= 0) {⎩385⎭
        ⌈ ## print(f"-- {x} : {RAM[x]}, {RAM[x + 1]}")  # Debug. ⌉⎩386⎭
        if (name = RAM[x + 1]) {  ⌈ # Match! ⌉⎩387⎭
            return x + 3⎩388⎭
        } else {⎩389⎭
            x ⇐ RAM[x]  ⌈ # Get next link. ⌉⎩390⎭
	}⎩391⎭
    }⎩392⎭
    return 0  ⌈ # Nothing found. ⌉⎩393⎭
}⎩394⎭
⎩395⎭
defsubr xfind {⎩396⎭
    ⌈ "( name | -- name 0|xt 1|xt -1) Search for word name." ⌉⎩397⎭
    %push (32)⎩398⎭
    @xword⎩399⎭
    deftemp found ⇐ %funcall _find(S[-1])⎩400⎭
    if (0 = found) {⎩401⎭
        %push (0)⎩402⎭
    } else {⎩403⎭
        %pop  ⌈ # Get rid of name on stack. ⌉⎩404⎭
        %push(found)⎩405⎭
        deftemp immediate ⇐ -1⎩406⎭
        if (RAM[S[-1] - 1] & 1) { immediate ⇐ 1 }⎩407⎭
        %push(immediate)⎩408⎭
    }⎩409⎭
}⎩410⎭
⎩411⎭
defsubr xtick {⎩412⎭
    ⌈ "( name -- xt|-1) Search for execution token of word name." ⌉⎩413⎭
    %push (32)⎩414⎭
    @xword⎩415⎭
    deftemp name ⇐ %pop⎩416⎭
    deftemp found ⇐ %funcall _find(name)⎩417⎭
    %push (found)⎩418⎭
}⎩419⎭
⎩420⎭
defsubr xnone {⎩421⎭
    %pushNone⎩422⎭
}⎩423⎭
⎩424⎭
⌈ fvget and fvset assume that the forth object (word) is a set of contiguous slots, each 1 machine word wide⎩425⎭
  these functions use direct integer offsets to access the fields of the fojbect, whereas in higher level languages⎩426⎭
  we'd use class fields instead - todo: fix this in the future (or not? at what point is customization better than⎩427⎭
  generalization?) ⌉⎩428⎭
deffunction fvget (name) {⎩429⎭
    deftemp fobjaddress ⇐ %funcall _find(%pop)⎩430⎭
    return RAM [fobjaddress + 1]⎩431⎭
}⎩432⎭
⎩433⎭
deffunction fvset (name, v) {⎩434⎭
    deftemp fobjaddress ⇐ %funcall _find(%pop)⎩435⎭
    defsynonym namefieldaddess ≡ fobjaddress + 1⎩436⎭
    RAM [namefieldaddress] ⇐ v⎩437⎭
}⎩438⎭
⎩439⎭
⎩440⎭
defsubr xwords {⎩441⎭
    ⌈ print words in dictionary ⌉⎩442⎭
    deftemp x ⇐ LAST⎩443⎭
    while (x > -1) {⎩444⎭
        %print (RAM [x+ 1])⎩445⎭
	%print (" ")⎩446⎭
    }⎩447⎭
    %eol⎩448⎭
}⎩449⎭
⎩450⎭
⎩451⎭
defsubr xexecute {⎩452⎭
    ⌈ invoke given word ⌉⎩453⎭
    deftemp wordAddress ⇐ %pop⎩454⎭
    @@wordAddress⎩455⎭
}⎩456⎭
⎩457⎭
⎩458⎭
defsubr doword {⎩459⎭
⌈⎩460⎭
Execute a colon-defined word using indirect threaded code interpretation.⎩461⎭
⎩462⎭
This function implements the inner interpreter for threaded code execution.⎩463⎭
Threaded code words store their definitions as arrays of code field addresses⎩464⎭
(CFAs) in the parameter field area (PFA) immediately following the word header.⎩465⎭
⎩466⎭
The execution model maintains two critical registers:⎩467⎭
⎩468⎭
1. IP (Instruction Pointer): References the current position within the⎩469⎭
   threaded code array being interpreted. Since threaded words may invoke⎩470⎭
   other threaded words, IP must be preserved in a reentrant manner via⎩471⎭
   the return stack on each invocation.⎩472⎭
⎩473⎭
2. W (Word Pointer): References the CFA of the currently executing primitive.⎩474⎭
   This global register serves an analogous function to 'self' in object-oriented⎩475⎭
   languages, enabling subroutines to access word header fields through fixed⎩476⎭
   offsets from the CFA.⎩477⎭
⎩478⎭
Optimization rationale: W is positioned to reference the CFA rather than the⎩479⎭
word header base. This design eliminates offset arithmetic for CFA access—the⎩480⎭
most frequent header operation—at the cost of requiring offset adjustments⎩481⎭
for other header fields (NFA: W-2, flags: W-1, PFA: W+1). This represents a⎩482⎭
deliberate trade-off favoring the common case.⎩483⎭
⎩484⎭
The inner interpreter loop performs the following operations:⎩485⎭
- Fetch the next CFA from RAM[IP] into W (performing the first indirection)⎩486⎭
- Increment IP to advance through the threaded code array⎩487⎭
- Execute the primitive via RAM[W]() (performing the second indirection)⎩488⎭
⎩489⎭
By caching the dereferenced CFA in W, we amortize the cost of double⎩490⎭
indirection: both primitive execution and header field access within⎩491⎭
subroutines utilize the same cached reference, avoiding redundant⎩492⎭
dereferences. This is functionally equivalent to parameter passing in⎩493⎭
object-oriented method invocation, but eliminates the overhead of⎩494⎭
explicitly passing 'self' to each primitive.⎩495⎭
⎩496⎭
Note: W's state is only defined during primitive execution (within RAM[W]()).⎩497⎭
Between loop iterations, W may reference a stale CFA, but this is⎩498⎭
architecturally sound since W is unconditionally updated before each⎩499⎭
primitive invocation.⎩500⎭
⌉⎩501⎭
⎩502⎭
    %rpush (IP)⎩503⎭
    IP ⇐ W + 1⎩504⎭
    while (-1 not= State.RAM[State.IP]) {⎩505⎭
        W ⇐ State.RAM[State.IP]⎩506⎭
	State.IP ⇐ State.IP + 1⎩507⎭
	@State.RAM[State.W]⎩508⎭
    }⎩509⎭
    IP ⇐ %rpop⎩510⎭
}⎩511⎭
⎩512⎭
defsubr xcolon {⎩513⎭
    ⌈ ( name | --) Start compilation. ⌉⎩514⎭
    defsynonym blank ≡ 32⎩515⎭
    %push (blank)⎩516⎭
    @word⎩517⎭
    deftemp name ⇐ %pop⎩518⎭
    code(name, doword)⎩519⎭
    %setCompilingState⎩520⎭
}⎩521⎭
⎩522⎭
defsubr xsemi {⎩523⎭
    ⌈ ( --) Finish definition. ⌉⎩524⎭
    %immediate⎩525⎭
    %funcall State.RAM.append(-1)  # Marker for end of definition.⎩526⎭
    %setNotCompilingState⎩527⎭
}⎩528⎭
⎩529⎭
defsubr xinterpret {⎩530⎭
    ⌈ ( string --) Execute word. ⌉⎩531⎭
⎩532⎭
    state ⇐ %getState⎩533⎭
⎩534⎭
    @xfind⎩535⎭
    immediate ⇐ %pop⎩536⎭
    if %inCompilationState {⎩537⎭
	    xt ⇐ %pop⎩538⎭
	    if immediate:⎩539⎭
		State.W ⇐ xt⎩540⎭
		State.IP ⇐ -1  # Dummy to hold place in return stack.⎩541⎭
		@State.RAM[xt]  # Execute code.⎩542⎭
	    else:⎩543⎭
		%funcall State.RAM.append(xt)⎩544⎭
     } else {⎩545⎭
	    word ⇐ %pop⎩546⎭
	    if (%isInteger (word)) {⎩547⎭
		%push (%toint (word))⎩548⎭
		if immediate {⎩549⎭
                        @internalize⎩550⎭
                }⎩551⎭
	    } elif (%isFloat (word)) {⎩552⎭
		%push (%tofloat (word))⎩553⎭
		if immediate {⎩554⎭
                        @internalize⎩555⎭
		}⎩556⎭
	    } else {⎩557⎭
		%clearS⎩558⎭
		%clearR⎩559⎭
		%print (word)⎩560⎭
		%print ("?")⎩561⎭
		%eol⎩562⎭
		return False⎩563⎭
	    }⎩564⎭
    ]⎩565⎭
    return True⎩566⎭
}⎩567⎭
⎩568⎭
⎩569⎭
⎩570⎭
⎩571⎭
⎩572⎭
⌈ Example of state-smart word, which Brodie sez not to do. Sorry, Leo... ⌉⎩573⎭
⌈ This sin allows it to be used the same way compiling or interactive. ⌉⎩574⎭
defsubr xquote {⎩575⎭
    "( -- string) Read up to closing quote, push to stack."⎩576⎭
    %immediate⎩577⎭
    %push (34);⎩578⎭
    @xword⎩579⎭
    if 1 = fvget("state") {⎩580⎭
        @literalize⎩581⎭
    }⎩582⎭
}⎩583⎭
⎩584⎭
defsubr xdotquote {⎩585⎭
    ⌈ ( --) Print string. ⌉⎩586⎭
    @xquote⎩587⎭
    %print (%pop)⎩588⎭
}⎩589⎭
⎩590⎭
defsubr xcomment {⎩591⎭
    ⌈ ( --) Read up to close paren. ⌉⎩592⎭
    %immediate⎩593⎭
    defsynonym rpar ≡ 41⎩594⎭
    %push (rpar)⎩595⎭
    @xword⎩596⎭
    %pop⎩597⎭
}⎩598⎭
⎩599⎭
⎩600⎭
defsubr doliteral {⎩601⎭
    ⌈ Inside definitions only, pushes compiled literal to stack. ⌉⎩602⎭
    %push (RAM[IP])  # Push item at IP on stack.⎩603⎭
    IP += 1          # Advance IP past item to continue execution.⎩604⎭
defsubr literalize:⎩605⎭
    "Compile literal into definition."⎩606⎭
    %funcall RAM.append(_find("(literal)"))  # Compile address of doliteral.⎩607⎭
    %funcall RAM.append(%pop)             # Compile literal value.⎩608⎭
⎩609⎭
⎩610⎭
⎩611⎭
defsubr xinterpret {⎩612⎭
    ⌈ ( string --) Execute word ⌉⎩613⎭
    deftemp word ⇐ %pop⎩614⎭
    if %empty-string? (word) {⎩615⎭
        pass⎩616⎭
    } else {⎩617⎭
        deftemps found, subr ⇐ %lookup (subrs, word)⎩618⎭
        if found {⎩619⎭
            @subr⎩620⎭
        } elif %digits? (word) {⎩621⎭
            deftemp i ⇐ %toint (word)⎩622⎭
            %push (i)⎩623⎭
        } else {⎩624⎭
            %print (word)⎩625⎭
            %print ("?")⎩626⎭
            %eol⎩627⎭
        }⎩628⎭
    }⎩629⎭
}⎩630⎭
⎩631⎭
defvar subrs ⇐ %freshdict⎩632⎭
%assoc (subrs, "drop", ↪︎xdrop)⎩633⎭
