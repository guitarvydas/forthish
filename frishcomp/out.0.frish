    %push (A * B)⎩55⎭
}⎩56⎭
⎩57⎭
defsubr xeq {⎩58⎭
    ⌈ ( a b -- bool ) ⌉⎩59⎭
    deftemp B ⇐ %pop⎩60⎭
    deftemp A ⇐ %pop⎩61⎭
    %push (A = B)⎩62⎭
}⎩63⎭
⎩64⎭
defsubr xlt {⎩65⎭
    ⌈ ( a b -- bool ) ⌉⎩66⎭
    deftemp B ⇐ %pop⎩67⎭
    deftemp A ⇐ %pop⎩68⎭
    %push (A < B)⎩69⎭
}⎩70⎭
⎩71⎭
defsubr xgt {⎩72⎭
    ⌈ ( a b -- bool ) ⌉⎩73⎭
    deftemp B ⇐ %pop⎩74⎭
    deftemp A ⇐ %pop⎩75⎭
    %push (A > B)⎩76⎭
}⎩77⎭
⎩78⎭
defsubr xeq0 {⎩79⎭
    ⌈ ( a -- bool ) ⌉⎩80⎭
    deftemp a ⇐ %pop⎩81⎭
    %push (a = 0)⎩82⎭
}⎩83⎭
⎩84⎭
defsubr x0lt {⎩85⎭
    ⌈ ( a -- bool ) ⌉⎩86⎭
    deftemp a ⇐ %pop⎩87⎭
    %push (0 < a)⎩88⎭
}⎩89⎭
⎩90⎭
defsubr x0gt {⎩91⎭
    ⌈ ( a -- bool ) ⌉⎩92⎭
    deftemp a ⇐ %pop⎩93⎭
