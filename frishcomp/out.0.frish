⎩671⎭
defsubr ok {⎩672⎭
    ⌈ ( --) Interaction loop -- REPL ⌉⎩673⎭
    defsynonym blank ≡ 32⎩674⎭
    while ⊤ {⎩675⎭
        %input⎩676⎭
        while not %empty-input {⎩677⎭
           if (@xinterpret) {⎩678⎭
	           %print (" ok")⎩679⎭
		   %eol⎩680⎭
	   }⎩681⎭
	   ]⎩682⎭
        }⎩683⎭
    }⎩684⎭
}⎩685⎭
⎩686⎭
@ok⎩687⎭
