    %push (a or b)⎩114⎭
}⎩115⎭
⎩116⎭
defsubr xStoR {⎩117⎭
    ⌈ ( a --  ) ⌉⎩118⎭
    deftemp a ⇐ %pop⎩119⎭
    %rpush (a)⎩120⎭
}⎩121⎭
⎩122⎭
defsubr xRtoS {⎩123⎭
    ⌈ ( -- x ) ⌉⎩124⎭
    deftemp x ⇐ %rpop⎩125⎭
    %push (x)⎩126⎭
}⎩127⎭
⎩128⎭
defsubr xi {⎩129⎭
    ⌈ ( -- i ) get current loop index from R stack ⌉⎩130⎭
    deftemp i ⇐ %rtop⎩131⎭
    %push (i)⎩132⎭
}⎩133⎭
⎩134⎭
defsubr xj {⎩135⎭
    ⌈ ( -- j ) get outer loop index from R stack ⌉⎩136⎭
