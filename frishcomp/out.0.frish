}⎩95⎭
⎩96⎭
defsubr xnot {⎩97⎭
    ⌈ ( a -- bool ) ⌉⎩98⎭
    deftemp a ⇐ %pop⎩99⎭
    %push (not a)⎩100⎭
}⎩101⎭
⎩102⎭
defsubr xand {⎩103⎭
    ⌈ ( a b -- bool ) ⌉⎩104⎭
    deftemp b ⇐ %pop⎩105⎭
    deftemp a ⇐ %pop⎩106⎭
    %push (a and b)⎩107⎭
}⎩108⎭
⎩109⎭
defsubr xor {⎩110⎭
    ⌈ ( a b -- bool ) ⌉⎩111⎭
    deftemp b ⇐ %pop⎩112⎭
