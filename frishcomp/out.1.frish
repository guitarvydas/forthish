}⎩37⎭
⎩38⎭
defsubr xcr { %eol }⎩39⎭
defsubr xdot { ⌈ ( n --) Print TOS ⌉ %print (%pop) %eol }⎩40⎭
defsubr xdots { ⌈ ( --) Print stack contents ⌉ %print (%stack) %eol }⎩41⎭
⎩42⎭
defsubr xadd {⎩43⎭
