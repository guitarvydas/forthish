defsubr xword {⎩161⎭
    ⌈ (char -- string) Read in string delimited by char ⌉⎩162⎭
    deftemp wanted ⇐ %popchar⎩163⎭
    %scanfor (wanted)⎩164⎭
}⎩165⎭
⎩166⎭
⌈ Example of state-smart word, which Brodie sez not to do. Sorry, Leo... ⌉⎩167⎭
⌈ This sin allows it to be used the same way compiling or interactive. ⌉⎩168⎭
defsubr xquote {⎩169⎭
    ⌈ ( -- string) Read up to closing dquote, push to stack ⌉⎩170⎭
    ⌈ A string in Forth begins with the word " (followed by a space) then all characters up to the next " ⌉⎩171⎭
    ⌈ E.G. " abc" ⌉⎩172⎭
    defsynonym DQ ≡ 34⎩173⎭
    %push (DQ)⎩174⎭
    @xword⎩175⎭
    if %inCompilationState {⎩176⎭
        %funcall literalize ()⎩177⎭
    }⎩178⎭
}⎩179⎭
⎩180⎭
defsubr xdotquote {⎩181⎭
    ⌈ ( -- ) parse and print a string ⌉⎩182⎭
    ⌈ ." Hello, World!" ⌉⎩183⎭
    @xquote⎩184⎭
    deftemp s ⇐ %pop⎩185⎭
    %print (s)⎩186⎭
}⎩187⎭
⎩188⎭
defsubr xcomment {⎩189⎭
    ⌈ ( -- ) parse and discard a comment ⌉⎩190⎭
    ⌈ e.g. ( a b c ) ⌉⎩191⎭
    defsynonym RPAR ≡ 42⎩192⎭
    %push(RPAR)⎩193⎭
    @xword⎩194⎭
    %pop⎩195⎭
}⎩196⎭
⎩197⎭
⎩198⎭
defsubr xdoliteral {⎩199⎭
    ⌈⎩200⎭
 Inside definitions only, pushes compiled literal to stack ⎩201⎭
    ⎩202⎭
     Certain Forth words are only applicable inside compiled sequences of subroutines ⎩203⎭
     Literals are handled in different ways when interpreted when in the REPL vs⎩204⎭
     compiled into sequences of subrs ⎩205⎭
     In the REPL, when we encounter a literal, we simply push it onto the stack ⎩206⎭
     In the compiler, though, we have to create an instruction that pushes ⎩207⎭
       the literal onto the stack. ⎩208⎭
       Compiled code doesn't do what the REPL does, we have to hard-wire and ⎩209⎭
       bake in code that pushes the literal when the time comes to run the sequence. ⎩210⎭
⎩211⎭
     This word - "(literal)" - is a simple case and one could actually type this ⎩212⎭
       instruction into the REPL, but, that would be redundant.  Other kinds of words, ⎩213⎭
       e.g. some control-flow words, tend to be messier and the code below only handles ⎩214⎭
       the compiled aspects and ignores the REPL aspects ⎩215⎭
⎩216⎭
     "IP" is the current word index in a sequence of words being compiled. ⎩217⎭
⌉⎩218⎭
    defsynonym lit ≡ RAM [IP]⎩219⎭
    %push (lit)⎩220⎭
    State.IP ⇐ State.IP + 1 ⌈ move past this item (the literal) - we're done with it ⌉⎩221⎭
}⎩222⎭
⎩223⎭
defsubr literalize {⎩224⎭
    deftemps found, address ⇐ %lookup (subrs, "(literal)")⎩225⎭
    %ignore (found)⎩226⎭
    %funcall RAM.append (address)⎩227⎭
    %funcall RAM.append (%pop)⎩228⎭
}⎩229⎭
⎩230⎭
defsubr xbranch {⎩231⎭
    ⌈ This instruction appears only inside subroutine sequences, jump to address in next cell ⌉⎩232⎭
    ⌈ This instruction is inserted into a subr sequence when compiling control-flow words, like "else" see below) ⌉⎩233⎭
    IP ⇐ RAM [IP]⎩234⎭
    ⌈ normally, we just execute an instruction then move the IP sequentially forward by 1 unit, i.e. IP ⇐ IP + 1 ⌉⎩235⎭
    ⌈   in this case, though, we explicitly change the IP to some other value and don't just increment it ⌉⎩236⎭
}⎩237⎭
⎩238⎭
defsubr x0branch {⎩239⎭
    ⌈ This instruction appears only inside subroutine sequences, jump on false to address in next cell ⌉⎩240⎭
    deftemp test ⇐ %toboolean (%pop)⎩241⎭
    if (test) {⎩242⎭
        State.IP ⇐ State.IP + 1⎩243⎭
    } else {⎩244⎭
        IP ⇐ RAM [IP]⎩245⎭
    }⎩246⎭
}⎩247⎭
⎩248⎭
⎩249⎭
⌈ "immediate" words are fully operational even when in compile mode. Some (not all) of these words are meant to⎩250⎭
    work /only/ in compile mode. At the REPL prompt ("interpret" mode), they produce unwanted results.⎩251⎭
  immediate words: xif, xelse, xthen, xquote, xcomment, xsemi⎩252⎭
  immediate words that only have meaning in compile mode: xif, xelse, xthen, xsemi⎩253⎭
⌉⎩254⎭
⎩255⎭
⎩256⎭
⌈ IF, ELSE and THEN are "immediate" words - they should only be used inside of ":" (colon compiler) ⌉⎩257⎭
⎩258⎭
⌈ see diagram `compiling-IF-THEN.drawio.png` ⌉⎩259⎭
defsubr xif {⎩260⎭
    %immediate ⌈ This instruction appears only inside subroutine sequences, ( f -- ) compile if test and branchFalse ⌉⎩261⎭
    ⌈ Step. 1: generate conditional branch to yet-unknown target1 ⌉⎩262⎭
    deftemps found, branchFalseAddress ⇐ %lookup (subrs, "0branch")⎩263⎭
    %ignore (found)⎩264⎭
    %funcall RAM.append (branchFalseAddress) ⌈ insert branch-if-false opcode (word) ⌉⎩265⎭
    %rpush (%RAMnext) ⌈ target1 onto r-stack as memo for later fixup ⌉⎩266⎭
    defsynonym target1 ≡ -1⎩267⎭
    %funcall RAM.append (target1) ⌈ branch target will be fixed up later ⌉⎩268⎭
    ⌈ Step. 2: generate code for true branch - return to compiler which will compile the following words ⌉⎩269⎭
    ⌈ THEN or ELSE will do the fixup of target1 ⌉⎩270⎭
}⎩271⎭
⎩272⎭
⌈ see diagram `compiling-IF-ELSE-THEN.drawio.png` ⌉⎩273⎭
defsubr xelse {⎩274⎭
    %immediate⎩275⎭
    ⌈ Step. 1: fixup target1 from IF-true, retrieving memo from R-stack ⌉⎩276⎭
    deftemp target1 ⇐ %rpop⎩277⎭
    RAM [target1] ⇐ %RAMnext⎩278⎭
    ⌈ Step. 2: generate unconditional branch for preceding IF, creating new memo for target2 on R-stack ⌉⎩279⎭
    deftemps found, brAddress ⇐ %lookup (subrs, "branch")⎩280⎭
    %rpush (%RAMnext) ⌈ target2 address on R-stack as memo for later fixup ⌉⎩281⎭
    defsynonym target2 ≡ -1⎩282⎭
    %funcall RAM.append (target2) ⌈ branch target will be fixed up later ⌉⎩283⎭
    ⌈ Step. 3: generate code for false branch - return to compiler which will compile the following words ⌉⎩284⎭
    ⌈ THEN will do the fixup of target2 ⌉⎩285⎭
}⎩286⎭
⎩287⎭
⌈ see diagrams `compiling-IF-THEN.drawio.png` and `compiling-IF-ELSE-THEN.drawio.png` ⌉⎩288⎭
defsubr xthen {⎩289⎭
    %immediate⎩290⎭
    ⌈ Step. 1: fixup target (from IF or from ELSE, above), retrieving memo from R-stack ⌉⎩291⎭
    deftemp target ⇐ %rpop⎩292⎭
    RAM [target] ⇐ %RAMnext⎩293⎭
}⎩294⎭
⎩295⎭
⎩296⎭
⌈  "... 123 constant K ..." ⌉⎩297⎭
⌈  at interpretation time: 123 is on the Stack, we have consumed "constant" from BUFF, BUFF now contains "K ..." ⌉⎩298⎭
⌈  invoke 'word' which parses "K" and pushed it. The stack becomes [... 123 "K"] ⌉⎩299⎭
⌈  pop "K", pop 123, create a new word called 'K' with its PFA set to 123 and its CFA set to a subr that⎩300⎭
     gets 123 from its PFA and pushes it onto the stack ⌉⎩301⎭
defsubr xconst {⎩302⎭
    ⌈  get next word - the name - from BUFF ⌉⎩303⎭
    defsynonym blank ≡ 32⎩304⎭
    %push (blank)⎩305⎭
    @word⎩306⎭
    ⌈  stack is now: ( NNNN name -- ) ⌉⎩307⎭
    deftemp name ⇐ %pop⎩308⎭
    deftemp value ⇐ %pop⎩309⎭
    defsynonym normal ≡ 0⎩310⎭
    deftemp fobj ⇐ %funcall code (name, normal, ↪︎doconst)⎩311⎭
    %fobjappend (fobj, value)⎩312⎭
}⎩313⎭
defsubr doconst {  ⌈ method for const ⌉⎩314⎭
    defsynonym parameter ≡ RAM [W + 1]⎩315⎭
    %push (parameter)⎩316⎭
}⎩317⎭
⎩318⎭
⎩319⎭
defsubr docreate {⎩320⎭
    defsynonym parameterAddress ≡ %funcall len (RAM) + 4⎩321⎭
    %push (parameterAddress)⎩322⎭
}⎩323⎭
deffunction create (name) {⎩324⎭
    defsynonym normal ≡ 0⎩325⎭
    %funcall code (name, normal, ↪︎docreate)⎩326⎭
}⎩327⎭
defsubr xcreate {⎩328⎭
    defsynonym blank ≡ 32⎩329⎭
    %push (blank)⎩330⎭
    @word⎩331⎭
    deftemp name ⇐ %pop⎩332⎭
    %funcall create (name)⎩333⎭
}⎩334⎭
⎩335⎭
deffunction comma (value) {⎩336⎭
    %funcall RAM.append (value)⎩337⎭
}⎩338⎭
⎩339⎭
defsubr xcomma {⎩340⎭
    %funcall comma (%pop)⎩341⎭
}⎩342⎭
⎩343⎭
deffunction fvar (name, value) {⎩344⎭
    %funcall create (name)⎩345⎭
    %funcall comma (value)⎩346⎭
}⎩347⎭
⎩348⎭
defsubr xvar {⎩349⎭
    defsynonym blank ≡ 32⎩350⎭
    %push (blank)⎩351⎭
    @word⎩352⎭
    deftemp name ⇐ %pop⎩353⎭
    deftemp value ⇐ %pop⎩354⎭
    %funcall fvar (name, value)    ⎩355⎭
}⎩356⎭
⎩357⎭
defsubr xdump {⎩358⎭
    deftemp n ⇐ %toint (%pop)⎩359⎭
    deftemp start ⇐ %toint (%pop)⎩360⎭
    %print ("----------------------------------------------------------------")⎩361⎭
    deftemp a ⇐ start⎩362⎭
    while (a < start + %funcall (min (n, (%funcall len (RAM) - start)))) {⎩363⎭
        %print (a)⎩364⎭
	%print (": ")⎩365⎭
	%print (RAM [a])⎩366⎭
	%eol⎩367⎭
        deftemp a ⇐ a + 1⎩368⎭
    }⎩369⎭
}⎩370⎭
⎩371⎭
defsubr xstore {⎩372⎭
    deftemp b ⇐ %pop⎩373⎭
    deftemp a ⇐ %pop⎩374⎭
    RAM [b] ⇐ a⎩375⎭
}⎩376⎭
⎩377⎭
defsubr xbye { ⌈ ( --) Leave interpreter ⌉ %quit }⎩378⎭
⎩379⎭
⎩380⎭
deffunction _find(name) {⎩381⎭
    ⌈ "( name -- cfa|0) Find CFA of word name." ⌉⎩382⎭
    deftemp x ⇐ LAST⎩383⎭
    while (x >= 0) {⎩384⎭
        ⌈ ## print(f"-- {x} : {RAM[x]}, {RAM[x + 1]}")  # Debug. ⌉⎩385⎭
        if (name = RAM[x + 1]) {  ⌈ # Match! ⌉⎩386⎭
            return x + 3⎩387⎭
        } else {⎩388⎭
            x ⇐ RAM[x]  ⌈ # Get next link. ⌉⎩389⎭
	}⎩390⎭
    }⎩391⎭
    return 0  ⌈ # Nothing found. ⌉⎩392⎭
}⎩393⎭
⎩394⎭
defsubr xfind {⎩395⎭
    ⌈ "( name | -- (name 0)|(xt 1)|(xt -1)) Search for word name." ⌉⎩396⎭
    ⌈ 3 possible results: 1. (name 0) if not found, 2. (xt 1) if found and word is immediate, 3. (xt -1) if found and word is normal ⌉⎩397⎭
    %push (32)⎩398⎭
    @xword⎩399⎭
    deftemp found ⇐ %funcall _find(S[-1])⎩400⎭
    if (0 = found) {⎩401⎭
        %push (0)⎩402⎭
    } else {⎩403⎭
        %pop  ⌈ # Get rid of name on stack. ⌉⎩404⎭
        %push(found)⎩405⎭
        deftemp immediate ⇐ -1⎩406⎭
        if (RAM[S[-1] - 1] & 1) { immediate ⇐ 1 }⎩407⎭
        %push(immediate)⎩408⎭
    }⎩409⎭
}⎩410⎭
⎩411⎭
defsubr xtick {⎩412⎭
    ⌈ "( name -- xt|-1) Search for execution token of word name." ⌉⎩413⎭
    %push (32)⎩414⎭
    @xword⎩415⎭
    deftemp name ⇐ %pop⎩416⎭
    deftemp found ⇐ %funcall _find(name)⎩417⎭
    %push (found)⎩418⎭
}⎩419⎭
⎩420⎭
defsubr xnone {⎩421⎭
    %pushNone⎩422⎭
}⎩423⎭
⎩424⎭
⌈ fvget and fvset assume that the forth object (word) is a set of contiguous slots, each 1 machine word wide⎩425⎭
  these functions use direct integer offsets to access the fields of the fojbect, whereas in higher level languages⎩426⎭
  we'd use class fields instead - todo: fix this in the future (or not? at what point is customization better than⎩427⎭
  generalization?) ⌉⎩428⎭
deffunction fvget (name) {⎩429⎭
    deftemp fobjaddress ⇐ %funcall _find(%pop)⎩430⎭
    return RAM [fobjaddress + 1]⎩431⎭
}⎩432⎭
⎩433⎭
deffunction fvset (name, v) {⎩434⎭
    deftemp fobjaddress ⇐ %funcall _find(%pop)⎩435⎭
    defsynonym namefieldaddess ≡ fobjaddress + 1⎩436⎭
    RAM [namefieldaddress] ⇐ v⎩437⎭
}⎩438⎭
⎩439⎭
⎩440⎭
defsubr xwords {⎩441⎭
    ⌈ print words in dictionary ⌉⎩442⎭
    deftemp x ⇐ LAST⎩443⎭
    while (x > -1) {⎩444⎭
        %print (RAM [x+ 1])⎩445⎭
	%print (" ")⎩446⎭
    }⎩447⎭
    %eol⎩448⎭
}⎩449⎭
⎩450⎭
⎩451⎭
defsubr xexecute {⎩452⎭
    ⌈ invoke given word ⌉⎩453⎭
    deftemp wordAddress ⇐ %pop⎩454⎭
    @@wordAddress⎩455⎭
}⎩456⎭
⎩457⎭
⎩458⎭
defsubr doword {⎩459⎭
⌈⎩460⎭
Execute a colon-defined word using indirect threaded code interpretation.⎩461⎭
⎩462⎭
This function implements the inner interpreter for threaded code execution.⎩463⎭
Threaded code words store their definitions as arrays of code field addresses⎩464⎭
(CFAs) in the parameter field area (PFA) immediately following the word header.⎩465⎭
⎩466⎭
The execution model maintains two critical registers:⎩467⎭
⎩468⎭
1. IP (Instruction Pointer): References the current position within the⎩469⎭
   threaded code array being interpreted. Since threaded words may invoke⎩470⎭
   other threaded words, IP must be preserved in a reentrant manner via⎩471⎭
   the return stack on each invocation.⎩472⎭
⎩473⎭
2. W (Word Pointer): References the CFA of the currently executing primitive.⎩474⎭
   This global register serves an analogous function to 'self' in object-oriented⎩475⎭
   languages, enabling subroutines to access word header fields through fixed⎩476⎭
   offsets from the CFA.⎩477⎭
⎩478⎭
Optimization rationale: W is positioned to reference the CFA rather than the⎩479⎭
word header base. This design eliminates offset arithmetic for CFA access—the⎩480⎭
most frequent header operation—at the cost of requiring offset adjustments⎩481⎭
for other header fields (NFA: W-2, flags: W-1, PFA: W+1). This represents a⎩482⎭
deliberate trade-off favoring the common case.⎩483⎭
⎩484⎭
The inner interpreter loop performs the following operations:⎩485⎭
- Fetch the next CFA from RAM[IP] into W (performing the first indirection)⎩486⎭
- Increment IP to advance through the threaded code array⎩487⎭
- Execute the primitive via RAM[W]() (performing the second indirection)⎩488⎭
⎩489⎭
By caching the dereferenced CFA in W, we amortize the cost of double⎩490⎭
indirection: both primitive execution and header field access within⎩491⎭
subroutines utilize the same cached reference, avoiding redundant⎩492⎭
dereferences. This is functionally equivalent to parameter passing in⎩493⎭
object-oriented method invocation, but eliminates the overhead of⎩494⎭
explicitly passing 'self' to each primitive.⎩495⎭
⎩496⎭
Note: W's state is only defined during primitive execution (within RAM[W]()).⎩497⎭
Between loop iterations, W may reference a stale CFA, but this is⎩498⎭
architecturally sound since W is unconditionally updated before each⎩499⎭
primitive invocation.⎩500⎭
⌉⎩501⎭
⎩502⎭
    %rpush (IP)⎩503⎭
    IP ⇐ W + 1⎩504⎭
    while (-1 != State.RAM[State.IP]) {⎩505⎭
        W ⇐ State.RAM[State.IP]⎩506⎭
	State.IP ⇐ State.IP + 1⎩507⎭
	@State.RAM[State.W]⎩508⎭
    }⎩509⎭
    IP ⇐ %rpop⎩510⎭
}⎩511⎭
⎩512⎭
defsubr xcolon {⎩513⎭
    ⌈ ( name | --) Start compilation. ⌉⎩514⎭
    defsynonym blank ≡ 32⎩515⎭
    %push (blank)⎩516⎭
    @word⎩517⎭
    deftemp name ⇐ %pop⎩518⎭
    %funcall code(name, doword)⎩519⎭
    %setCompilingState⎩520⎭
}⎩521⎭
⎩522⎭
defsubr xsemi {⎩523⎭
    ⌈ ( --) Finish definition. ⌉⎩524⎭
    %immediate⎩525⎭
    %funcall State.RAM.append(-1)  ⌈ Marker for end of definition. ⌉⎩526⎭
    %setNotCompilingState⎩527⎭
}⎩528⎭
⎩529⎭
defsubr xinterpret {⎩530⎭
    ⌈ ( string --) Execute word. ⌉⎩531⎭
⎩532⎭
    @xfind⎩533⎭
    ⌈ 3 possible results from xfind:⎩534⎭
        1. (name 0) if not found,⎩535⎭
	2. (xt 1) if found and word is immediate,⎩536⎭
	3. (xt -1) if found and word is normal ⌉⎩537⎭
    deftemp result ⇐ %pop					    defsynonym foundImmediate ≡ (result = 1)⎩538⎭
    deftemp item ⇐ %pop					    defsynonym foundNormal ≡ (result = -1)⎩539⎭
    	    	   						    defsynonym notFound ≡ (result = 0)⎩540⎭
    if (foundImmediate or foundNormal) {⎩541⎭
	if %inCompilationState {				    defsynonym xt ≡ item⎩542⎭
	    if foundImmediate {⎩543⎭
		State.W ⇐ xt⎩544⎭
		State.IP ⇐ -1  ⌈ Dummy to hold place in return stack. ⌉⎩545⎭
		@State.RAM[xt]  ⌈ Execute code. ⌉⎩546⎭
	    } else {⎩547⎭
		%funcall State.RAM.append(xt)⎩548⎭
	    }⎩549⎭
	 } else {⎩550⎭
	    ⌈ not compiling ⌉⎩551⎭
	    %funcall State.RAM.append (xt)⎩552⎭
	 }⎩553⎭
     } else {							    defsynonym word ≡ item⎩554⎭
	 if (%isInteger (word)) {⎩555⎭
	     %push (%toint (word))⎩556⎭
	     if %inCompilationState {⎩557⎭
		     @literalize⎩558⎭
	     }⎩559⎭
	 } elif (%isFloat (word)) {⎩560⎭
	     %push (%tofloat (word))⎩561⎭
	     if %inCompilationState {⎩562⎭
		     @literalize⎩563⎭
	     }⎩564⎭
	 } else {⎩565⎭
	     %clearS⎩566⎭
	     %clearR⎩567⎭
	     %print (word)⎩568⎭
	     %print ("?")⎩569⎭
	     %eol⎩570⎭
	     return False⎩571⎭
	 }⎩572⎭
    }⎩573⎭
    return True⎩574⎭
}⎩575⎭
⎩576⎭
⎩577⎭
⎩578⎭
⎩579⎭
⎩580⎭
⌈ Example of state-smart word, which Brodie sez not to do. Sorry, Leo... ⌉⎩581⎭
⌈ This sin allows it to be used the same way compiling or interactive. ⌉⎩582⎭
defsubr xquote {⎩583⎭
    ⌈ ( -- string) Read up to closing quote, push to stack. ⌉⎩584⎭
    %immediate⎩585⎭
    %push (34)⎩586⎭
    @xword⎩587⎭
    if 1 = %funcall fvget("state") {⎩588⎭
        @literalize⎩589⎭
    }⎩590⎭
}⎩591⎭
⎩592⎭
defsubr xdotquote {⎩593⎭
    ⌈ ( --) Print string. ⌉⎩594⎭
    @xquote⎩595⎭
    %print (%pop)⎩596⎭
}⎩597⎭
⎩598⎭
defsubr xcomment {⎩599⎭
    ⌈ ( --) Read up to close paren. ⌉⎩600⎭
    %immediate⎩601⎭
    defsynonym rpar ≡ 41⎩602⎭
    %push (rpar)⎩603⎭
    @xword⎩604⎭
    %pop⎩605⎭
}⎩606⎭
⎩607⎭
⎩608⎭
defsubr doliteral {⎩609⎭
    ⌈ Inside definitions only, pushes compiled literal to stack. ⌉⎩610⎭
    %push (RAM[IP])  ⌈ Push item at IP on stack. ⌉⎩611⎭
    State.IP ⇐ State.IP + 1          ⌈ Advance IP past item to continue execution. ⌉⎩612⎭
}⎩613⎭
⎩614⎭
defsubr literalize {⎩615⎭
    ⌈ Compile literal into definition. ⌉⎩616⎭
    %funcall RAM.append(_find("(literal)"))  ⌈ Compile address of doliteral. ⌉⎩617⎭
    %funcall RAM.append(%pop)             ⌈ Compile literal value. ⌉⎩618⎭
}⎩619⎭
⎩620⎭
⎩621⎭
defsubr ok {⎩622⎭
    ⌈ ( --) Interaction loop -- REPL ⌉⎩623⎭
    defsynonym blank ≡ 32⎩624⎭
    while ⊤ {⎩625⎭
        %input⎩626⎭
        while not %empty-input {⎩627⎭
           if (@xinterpret) {⎩628⎭
	           %print (" ok")⎩629⎭
		   %eol⎩630⎭
	   }⎩631⎭
        }⎩632⎭
    }⎩633⎭
}⎩634⎭
⎩635⎭
@ok⎩636⎭
    ⎩637⎭